[Unit]
Description=Synchronize an externally managed hTun TLS certificate

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/htun/sync-cert.sh /etc/ssl/htun/source.crt /etc/ssl/htun/source.key /etc/htun/tls
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/ssl/htun
ReadWritePaths=/etc/htun/tls
CapabilityBoundingSet=CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX
