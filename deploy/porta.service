[Unit]
Description=Porta VPN gateway
After=network-online.target porta-cert-sync.service docker.service
Wants=network-online.target porta-cert-sync.service

[Service]
Type=simple
EnvironmentFile=/etc/porta/porta.env
ExecStartPre=/bin/sh -c 'test -s /etc/porta/tls/server.crt && test -s /etc/porta/tls/server.key'
ExecStart=/usr/local/bin/porta-server --listen :8443 --admin-listen 127.0.0.1:9090 --tls-cert /etc/porta/tls/server.crt --tls-key /etc/porta/tls/server.key --client-registry /var/lib/porta/clients.json --client-downloads /var/lib/porta/downloads --usage-state /var/lib/porta/usage.json --interface porta0 --egress-interface eth0 --pool 10.66.0.0/24 --lease-state /var/lib/porta/leases.json --dns 1.1.1.1 --auto-mtu=true --mtu 1400 --json-logs
ExecStartPost=/bin/bash -c 'for i in $(seq 1 50); do /usr/sbin/ip link show dev porta0 >/dev/null 2>&1 && exec /usr/local/libexec/porta/server-up.sh porta0 10.66.0.1/24 10.66.0.0/24 eth0 --auto-mtu=true; sleep 0.1; done; exit 1'
ExecStopPost=/usr/local/libexec/porta/server-down.sh porta0 eth0
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
LimitNOFILE=65536
UMask=0077
StateDirectory=porta
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
