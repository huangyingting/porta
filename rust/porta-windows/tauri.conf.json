{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Porta",
  "identifier": "dev.porta.windows",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Porta",
        "width": 500,
        "height": 720,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "maximizable": false,
        "minimizable": true,
        "center": true,
        "devtools": false,
        "backgroundColor": "#08111f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/porta.ico"
    ]
  }
}
